{
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node", // Название браузера, который должен быть установлен и в котором будет открыт тестируемый файл
        "request": "launch", // Команда, которую необходимо выполнить дебагеру
        "name": "Launch index.js", // Название конфигурации (конфигураций может быть много, сделано для удобства запуска из debug-панели в VS Code)
        "program": "${workspaceFolder}\\index.js"
        //"file": "index.js" // Название файла, к которому применить команду из пункта "request"
      }
    ]
  }